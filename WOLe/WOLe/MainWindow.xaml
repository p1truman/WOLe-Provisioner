<Window
    x:Class="WOLe.Provisioner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WOLe.Provisioner.Views"
    xmlns:local="using:WOLe.Provisioner"
    xmlns:muxc="using:Microsoft.UI.Xaml"
    Title="WOL-e">

    <Grid>

        <!-- MAIN CONTENT FRAME -->
        <Frame x:Name="RootFrame"
               Navigated="RootFrame_Navigated" />

        <!-- WIZARD FOOTER -->
        <Grid x:Name="WizardFooter"
              VerticalAlignment="Bottom"
              Background="#1A000000"
              Padding="16"
              Height="64"
              Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Content="Back"
                    Click="Back_Click"
                    Margin="0,0,12,0"/>

            <Button x:Name="NextButton"
                    Content="Next"
                    Grid.Column="2"
                    Click="Next_Click"/>
        </Grid>

    </Grid>
</Window>
