<Page
    x:Class="WOLe.Provisioner.Views.SinricPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">

        <StackPanel Spacing="28"
                    MaxWidth="480"
                    HorizontalAlignment="Center">

            <!-- PAGE TITLE -->
            <TextBlock Text="Sinric Pro Credentials"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,48,0,0" />

            <!-- INTRO TEXT -->
            <TextBlock Text="Enter your Sinric Pro App Key and App Secret."
                       Style="{StaticResource PageIntroStyle}"
                       MaxWidth="480" />

            <!-- APP KEY -->
            <TextBox x:Name="AppKeyTextBox"
                     Header="App Key"
                     PlaceholderText="" />

            <!-- APP SECRET -->
            <TextBox x:Name="AppSecretTextBox"
                     Header="App Secret"
                     PlaceholderText="" />

            <!-- ERROR TEXT -->
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource ConfigBodyTextStyle}"
                       Foreground="{ThemeResource ConfigErrorBrush}"
                       Visibility="Collapsed"
                       Margin="0,8,0,0" />

        </StackPanel>

    </Grid>
</Page>
