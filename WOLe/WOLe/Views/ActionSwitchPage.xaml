<Page
    x:Class="WOLe.Provisioner.Views.ActionSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24"
                        MaxWidth="660"
                        HorizontalAlignment="Center">

                <TextBlock Text="WOL-e Enhanced Functionality"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,40,0,5" />

                <TextBlock Text="Configure the ON/OFF action mapping for this Enhanced Device."
                           Style="{StaticResource PageIntroStyle}"
                           MaxWidth="700" />

                <TextBlock x:Name="ContextTitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Foreground="{ThemeResource ConfigHeaderBrush}" />

                <!-- Fixed-width action row -->
                <Grid Margin="0,8,0,0"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}">
                        <Run Text="ON" Foreground="LimeGreen"/>
                        <Run Text=" Action"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}">
                        <Run Text="OFF" Foreground="Red"/>
                        <Run Text=" Action"/>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,4,0,0"
                      ColumnSpacing="16"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeviceLabelText"
                               Grid.Column="0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource ConfigAccentBrush}" />
                    <ComboBox x:Name="OnActionComboBox"
                              Grid.Column="1"
                              Width="220"
                              HorizontalAlignment="Left"
                              PlaceholderText="Select ON action..." />
                    <ComboBox x:Name="OffActionComboBox"
                              Grid.Column="2"
                              Width="220"
                              HorizontalAlignment="Left"
                              PlaceholderText="Select OFF action..." />
                </Grid>

                <!-- Volume step panel -->
                <StackPanel x:Name="VolumeStepPanel"
                            Visibility="Collapsed"
                            Spacing="12"
                            Margin="0,8,0,0">
                    <TextBlock Text="Volume Step Settings"
                               Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <TextBlock Text="Set independent step sizes used by Volume Up and Volume Down actions."
                               Style="{StaticResource ConfigBodyTextStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="VolumeUpStepContainer" Grid.Column="0" Visibility="Collapsed" Spacing="6">
                            <TextBlock Text="Volume Up Step (%)" Style="{StaticResource ConfigSectionHeaderStyle}" />
                            <ComboBox x:Name="VolumeUpStepComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel x:Name="VolumeDownStepContainer" Grid.Column="1" Visibility="Collapsed" Spacing="6">
                            <TextBlock Text="Volume Down Step (%)" Style="{StaticResource ConfigSectionHeaderStyle}" />
                            <ComboBox x:Name="VolumeDownStepComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- APP BINDINGS PANEL -->
                <StackPanel x:Name="Pc1AppBindingsPanel"
                            Visibility="Collapsed"
                            Spacing="16"
                            Margin="0,16,0,0">

                    <TextBlock Text="Application Bindings for PC 1"
                               Style="{StaticResource ConfigSectionHeaderStyle}" />

                    <TextBlock Text="Select the local application to launch when these actions are triggered on PC 1. Other PCs can be configured when running the Enhanced Actions Installer on those machines."
                               Style="{StaticResource ConfigBodyTextStyle}" />

                    <StackPanel x:Name="LaunchApp1Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 1" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp1ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp1ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp1Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp1_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp1PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp2Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 2" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp2ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp2ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp2Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp2_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp2PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp3Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 3" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp3ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp3ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp3Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp3_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp3PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp4Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 4" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp4ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp4ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp4Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp4_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp4PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp5Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 5" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp5ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp5ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp5Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp5_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp5PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp6Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 6" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp6ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp6ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp6Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp6_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp6PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp7Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 7" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp7ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp7ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp7Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp7_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp7PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchApp8Panel" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="Launch App 8" Style="{StaticResource ConfigSectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LaunchApp8ComboBox" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="LaunchApp8ComboBox_SelectionChanged" />
                            <Button x:Name="BrowseLaunchApp8Button" Content="Browse..." Grid.Column="1" Height="32" Click="BrowseLaunchApp8_Click" />
                        </Grid>
                        <TextBlock x:Name="LaunchApp8PathText" Style="{StaticResource ConfigBodyTextStyle}" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>

                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="{ThemeResource ConfigErrorBrush}"
                           Visibility="Collapsed"
                           Margin="0,4,0,0"
                           Style="{StaticResource ConfigBodyTextStyle}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>