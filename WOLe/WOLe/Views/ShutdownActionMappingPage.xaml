<Page
    x:Class="WOLe.Provisioner.Views.ShutdownActionMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource WoleNeonBlueColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource WoleNeonBlueColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource WoleNeonBlueColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource WoleNeonBlueColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource WoleNeonBlueColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource WoleNeonBlueColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />
    </Page.Resources>

    <Grid Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="660"
                        HorizontalAlignment="Center"
                        Spacing="20">

                <TextBlock Text="Launch App Configuration"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,36,0,0" />

                <TextBlock Text="Configure the application bindings for this PC. Hover over a selected app to see its full path."
                           Style="{StaticResource PageIntroStyle}"
                           TextAlignment="Center"
                           MaxWidth="660"
                           Margin="0,0,0,4" />

                <Grid RowSpacing="18" ColumnSpacing="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Launch App 1 ── -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Launch App 1:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp1Toggle" Grid.Row="0" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp1Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp1ComboBox" Grid.Row="0" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp1ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp1Button" Grid.Row="0" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp1_Click" />

                    <!-- ── Launch App 2 ── -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Launch App 2:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp2Toggle" Grid.Row="1" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp2Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp2ComboBox" Grid.Row="1" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp2ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp2Button" Grid.Row="1" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp2_Click" />

                    <!-- ── Launch App 3 ── -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Launch App 3:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp3Toggle" Grid.Row="2" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp3Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp3ComboBox" Grid.Row="2" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp3ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp3Button" Grid.Row="2" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp3_Click" />

                    <!-- ── Launch App 4 ── -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Launch App 4:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp4Toggle" Grid.Row="3" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp4Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp4ComboBox" Grid.Row="3" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp4ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp4Button" Grid.Row="3" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp4_Click" />

                    <!-- ── Launch App 5 ── -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Launch App 5:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp5Toggle" Grid.Row="4" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp5Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp5ComboBox" Grid.Row="4" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp5ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp5Button" Grid.Row="4" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp5_Click" />

                    <!-- ── Launch App 6 ── -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Launch App 6:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp6Toggle" Grid.Row="5" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp6Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp6ComboBox" Grid.Row="5" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp6ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp6Button" Grid.Row="5" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp6_Click" />

                    <!-- ── Launch App 7 ── -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Launch App 7:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp7Toggle" Grid.Row="6" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp7Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp7ComboBox" Grid.Row="6" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp7ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp7Button" Grid.Row="6" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp7_Click" />

                    <!-- ── Launch App 8 ── -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Launch App 8:"
                               VerticalAlignment="Center" Style="{StaticResource ConfigSectionHeaderStyle}" />
                    <ToggleSwitch x:Name="UsesLaunchApp8Toggle" Grid.Row="7" Grid.Column="1"
                                  VerticalAlignment="Center" Toggled="UsesLaunchApp8Toggle_Toggled" />
                    <ComboBox x:Name="LaunchApp8ComboBox" Grid.Row="7" Grid.Column="2"
                              Margin="-50,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              SelectionChanged="LaunchApp8ComboBox_SelectionChanged" />
                    <Button x:Name="BrowseLaunchApp8Button" Grid.Row="7" Grid.Column="3"
                            Content="Browse..." Height="32" VerticalAlignment="Center"
                            Click="BrowseLaunchApp8_Click" />

                </Grid>

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource ConfigBodyTextStyle}"
                           Foreground="{ThemeResource ConfigErrorBrush}"
                           Visibility="Collapsed"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>