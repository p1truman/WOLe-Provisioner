<Page
    x:Class="WOLe.Provisioner.Views.WifiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32">
            <StackPanel Spacing="28"
                        MaxWidth="480"
                        HorizontalAlignment="Center">

                <TextBlock Text="Wi‑Fi Configuration"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,48,0,0" />

                <TextBlock Text="Enter the SSID and password for your Wi‑Fi network."
                           Style="{StaticResource PageIntroStyle}"
                           MaxWidth="480" />

                <TextBox x:Name="SsidTextBox"
                         Header="SSID"
                         PlaceholderText="" />

                <PasswordBox x:Name="PasswordBox"
                             Header="Password"
                             PlaceholderText="" />

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource ConfigBodyTextStyle}"
                           Foreground="{ThemeResource ConfigErrorBrush}"
                           Visibility="Collapsed"
                           Margin="0,8,0,0" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>