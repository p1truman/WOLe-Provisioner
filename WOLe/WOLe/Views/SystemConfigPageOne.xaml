<Page
    x:Class="WOLe.Provisioner.Views.SystemConfigPageOne"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WOLe.Provisioner.Controls">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ConfigCardBackgroundBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="ConfigCardBorderBrush" Color="#242424" />
                    <SolidColorBrush x:Key="ConfigHeaderBrush" Color="White" />
                    <SolidColorBrush x:Key="ConfigSubtextBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="ConfigAccentBrush" Color="#0cd3f7" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ConfigCardBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ConfigCardBorderBrush" Color="#D7D7D7" />
                    <SolidColorBrush x:Key="ConfigHeaderBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ConfigSubtextBrush" Color="#555555" />
                    <SolidColorBrush x:Key="ConfigAccentBrush" Color="#0cd3f7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ConfigCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ConfigCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ConfigCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.25" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="28,16,28,20" />
            </Style>

            <Style x:Key="ConfigSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource ConfigHeaderBrush}" />
            </Style>

            <Style x:Key="ConfigBodyTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource ConfigSubtextBrush}" />
            </Style>

            <Style x:Key="BulletStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ConfigAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Width" Value="20" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,1,10,0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28">
            <StackPanel Spacing="16"
                        MaxWidth="1040"
                        HorizontalAlignment="Center">

                <TextBlock Text="System Configuration"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,6" />

                <!-- Updated to match intro text sizing/style used across pages -->
                <TextBlock x:Name="FlowSubtitleText"
                           Style="{StaticResource PageIntroStyle}"
                           MaxWidth="700"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,8"
                           Text="" />

                <Border Style="{StaticResource ConfigCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="BIOS Configuration"
                                   Style="{StaticResource ConfigSectionHeaderStyle}" />

                        <StackPanel Spacing="10">

                            <Grid Margin="30,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="•"
                                           Style="{StaticResource BulletStyle}" />

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ConfigBodyTextStyle}"
                                           LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight">
                                    <Run Text="Restart your system and press the key to enter" />
                                    <Run Text="BIOS/UEFI" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="(usually" />
                                    <Run Text="F2, F10, F12" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="or" />
                                    <Run Text="Del" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text=")." />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="30,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="•"
                                           Style="{StaticResource BulletStyle}" />

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ConfigBodyTextStyle}"
                                           LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight">
                                    <Run Text="Navigate to the" />
                                    <Run Text="Power Management" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="or" />
                                    <Run Text="Advanced" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="tab." />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="30,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="•"
                                           Style="{StaticResource BulletStyle}" />

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ConfigBodyTextStyle}"
                                           LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight">
                                    <Run Text="Enable settings such as" />
                                    <Run Text="Wake on LAN" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="," />
                                    <Run Text="Power on by PCIe" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="or" />
                                    <Run Text="Resume on LAN" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text="." />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="30,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="•"
                                           Style="{StaticResource BulletStyle}" />

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ConfigBodyTextStyle}"
                                           LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight">
                                    <Run Text="Exit and save changes (usually" />
                                    <Run Text="F10" FontWeight="SemiBold" Foreground="{ThemeResource ConfigHeaderBrush}" />
                                    <Run Text=")." />
                                </TextBlock>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ConfigCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Network Provisioning"
                                   Style="{StaticResource ConfigSectionHeaderStyle}" />

                        <TextBlock Text="To ensure your machine remains consistently identifiable, we'll need to configure a static IPv4 address."
                                   Style="{StaticResource ConfigBodyTextStyle}"
                                   TextAlignment="Left"
                                   Margin="0,0,0,10" />

                        <controls:UnifiedProvisioningControl x:Name="UnifiedProvisioningControl" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>