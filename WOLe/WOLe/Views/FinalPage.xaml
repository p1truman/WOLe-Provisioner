<Page
    x:Class="WOLe.Provisioner.Views.FinalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>

            <!-- Keep only the custom bullet style -->
            <Style x:Key="BulletStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ConfigAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Width" Value="20" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,1,10,0" />
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Spacing="16">

            <!-- TITLE -->
            <TextBlock Text="WOL-e Device Setup Complete"
                       Style="{StaticResource PageTitleStyle}" />

            <!-- SUBTITLE -->
            <TextBlock Text="Reboot to initialise services"
                       Style="{StaticResource ConfigSectionHeaderStyle}"
                       TextAlignment="Center" />

            <!-- SECTION HEADER -->
            <TextBlock Text="Still to do"
                       Style="{StaticResource ConfigSectionHeaderStyle}" />

            <!-- BULLET 1 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="•"
                           Style="{StaticResource BulletStyle}" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource ConfigBodyTextStyle}">
                    <Run Text="Run the Enhanced Actions installer (step 4) on any other machines within your WOL-e network." />
                </TextBlock>
            </Grid>

            <!-- BULLET 2 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="•"
                           Style="{StaticResource BulletStyle}" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource ConfigBodyTextStyle}">
                    <Run Text="Enable the Sinric Pro skill in your selected smart home assistant and create custom voice activated routines for all found devices." />
                </TextBlock>
            </Grid>

            <!-- DONE BUTTON -->
            <Button x:Name="ExitButton"
                    Content="Done"
                    Width="160"
                    Height="48"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Click="ExitButton_Click" />

        </StackPanel>
    </Grid>
</Page>
