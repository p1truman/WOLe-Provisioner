<Page
    x:Class="WOLe.Provisioner.Views.ShutdownSecretPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32">
            <StackPanel Spacing="28"
                        MaxWidth="480"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="HeaderText"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,48,0,0" />

                <TextBlock x:Name="DescriptionText"
                           Style="{StaticResource PageIntroStyle}"
                           TextAlignment="Center"
                           MaxWidth="480" />

                <TextBox x:Name="SecretBox"
                         Header="Secret Key"
                         PlaceholderText="" />

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource ConfigBodyTextStyle}"
                           Foreground="{ThemeResource ConfigErrorBrush}"
                           Visibility="Collapsed"
                           Margin="0,4,0,0" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>