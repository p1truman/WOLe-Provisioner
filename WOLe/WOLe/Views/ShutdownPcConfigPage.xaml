<Page
    x:Class="WOLe.Provisioner.Views.ShutdownPcConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">

        <StackPanel Spacing="28"
                    MaxWidth="480"
                    HorizontalAlignment="Center">

            <!-- PAGE TITLE -->
            <TextBlock Text="PC Configuration"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,48,0,0" />

            <!-- DESCRIPTION -->
            <TextBlock Text="Enter your predefined IP address and port number for this PC."
                       Style="{StaticResource PageIntroStyle}"
                       TextAlignment="Center"
                       MaxWidth="480" />

            <!-- IP ADDRESS -->
            <TextBox x:Name="IpBox"
                     Header="PC IP Address"
                     PlaceholderText="192.168.1.100"
                     Margin="0,8,0,0" />

            <!-- PORT -->
            <TextBox x:Name="PortBox"
                     Header="Port"
                     PlaceholderText="8080"
                     Margin="0,8,0,0" />

            <!-- ERROR TEXT -->
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource ConfigBodyTextStyle}"
                       Foreground="{ThemeResource ConfigErrorBrush}"
                       Visibility="Collapsed"
                       TextAlignment="Center"
                       Margin="0,8,0,0" />

        </StackPanel>

    </Grid>
</Page>
