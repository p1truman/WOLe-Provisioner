<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ConfigHeaderBrush" Color="White" />
            <SolidColorBrush x:Key="ConfigSubtextBrush" Color="#D0D0D0" />
            <SolidColorBrush x:Key="ConfigDividerBrush" Color="#242424" />
            <SolidColorBrush x:Key="ConfigAccentBrush" Color="#0cd3f7" />
            <SolidColorBrush x:Key="ConfigErrorBrush" Color="#FF9B9B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ConfigHeaderBrush" Color="#111111" />
            <SolidColorBrush x:Key="ConfigSubtextBrush" Color="#555555" />
            <SolidColorBrush x:Key="ConfigDividerBrush" Color="#D7D7D7" />
            <SolidColorBrush x:Key="ConfigAccentBrush" Color="#0cd3f7" />
            <SolidColorBrush x:Key="ConfigErrorBrush" Color="#B42318" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
