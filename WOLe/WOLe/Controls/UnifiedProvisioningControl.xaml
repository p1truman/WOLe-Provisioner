<UserControl
    x:Class="WOLe.Provisioner.Controls.UnifiedProvisioningControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="EditableOctetBackgroundBrush" Color="#1A2330" />
                    <SolidColorBrush x:Key="EditableOctetBorderBrush" Color="#355070" />
                    <SolidColorBrush x:Key="OctetWarningBrush" Color="#FFB3B3" />
                    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#7EE787" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF9B9B" />
                    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#D0D7DE" />
                    <SolidColorBrush x:Key="ConfigHeaderBrush" Color="White" />
                    <SolidColorBrush x:Key="ConfigSubtextBrush" Color="#D0D0D0" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EditableOctetBackgroundBrush" Color="#EAF3FF" />
                    <SolidColorBrush x:Key="EditableOctetBorderBrush" Color="#8CB7E8" />
                    <SolidColorBrush x:Key="OctetWarningBrush" Color="#B00020" />
                    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#1A7F37" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#444444" />
                    <SolidColorBrush x:Key="ConfigHeaderBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ConfigSubtextBrush" Color="#555555" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ProvisioningSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource ConfigHeaderBrush}" />
            </Style>

            <Style x:Key="ProvisioningBodyTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.92" />
                <Setter Property="Foreground" Value="{ThemeResource ConfigSubtextBrush}" />
            </Style>

            <Style x:Key="ProvisioningDetailTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.92" />
                <Setter Property="Foreground" Value="{ThemeResource ConfigSubtextBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel Spacing="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.35*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Select Network Adapter"
                               Style="{StaticResource ProvisioningSectionHeaderStyle}"
                               Margin="0,0,0,4" />

                    <ComboBox x:Name="AdapterSelector"
                              Width="370"
                              PlaceholderText="Choose adapter..."
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="AdapterSelector_SelectionChanged" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Top"
                        Click="CopyAdapterDetails_Click"
                        ToolTipService.ToolTip="Click to copy credentials to clipboard">

                    <StackPanel Spacing="2">
                        <TextBlock Text="Adapter Details"
                                   Style="{StaticResource ProvisioningSectionHeaderStyle}"
                                   Margin="30,0,0,0" />

                        <TextBlock x:Name="IpAddressText"
                                   Text="IPv4: —"
                                   Style="{StaticResource ProvisioningDetailTextStyle}"
                                   Margin="30,0,0,0" />

                        <TextBlock x:Name="MacAddressText"
                                   Text="MAC: —"
                                   Style="{StaticResource ProvisioningDetailTextStyle}"
                                   Margin="30,0,0,0" />

                        <TextBlock x:Name="GatewayText"
                                   Text="Gateway: —"
                                   Style="{StaticResource ProvisioningDetailTextStyle}"
                                   Margin="30,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Spacing="6"
                        HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource ProvisioningBodyTextStyle}"
           MaxWidth="840"
           HorizontalAlignment="Left"
           TextAlignment="Left"
           Margin="0,0,0,10">
    <Run Text="Enter a memorable IPv4 address for this machine. Then" />
    <Run Text="Apply"
         FontWeight="SemiBold"
         Foreground="{ThemeResource ConfigHeaderBrush}" />
    <Run Text="and" />
    <Run Text="Optimise."
         FontWeight="SemiBold"
         Foreground="{ThemeResource ConfigHeaderBrush}" />
 
</TextBlock>

                <TextBlock Text="Static IPv4 Address"
                           Style="{StaticResource ProvisioningSectionHeaderStyle}"
                           HorizontalAlignment="Left" />

                <Grid Width="660">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="140"
                            Height="30"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock x:Name="IpPrefixText"
                                   Text="0 . 0 . 0 ."
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   CharacterSpacing="40" />
                    </Border>

                    <TextBox x:Name="IpOctet4Box"
                             Grid.Column="1"
                             Width="60"
                             Height="30"
                             Margin="10,0,0,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             TextAlignment="Center"
                             Background="{ThemeResource EditableOctetBackgroundBrush}"
                             BorderBrush="{ThemeResource EditableOctetBorderBrush}"
                             BorderThickness="1.25"
                             Text="0"
                             TextChanged="IpOctet4Box_TextChanged" />

                    <Button Grid.Column="2"
                            Content="Apply"
                            Width="100"
                            Height="30"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Click="ApplyManualStaticIp_Click" />

                    <Button Grid.Column="4"
                            Content="Optimise"
                            Width="110"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="EnableWol_Click" />
                </Grid>

                <TextBlock Style="{StaticResource ProvisioningBodyTextStyle}"
                           HorizontalAlignment="Left"
                           TextAlignment="Left"
                           Margin="0,14,0,0">
                    <Run Text="Before proceeding, click" />
                    <Run Text="Adapter Details"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource ConfigHeaderBrush}" />
                    <Run Text="to copy credentials to clipboard. They'll be requested shortly." />
                </TextBlock>

            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource StatusNeutralBrush}"
                       Opacity="0.95"
                       MaxWidth="840"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0" />

        </StackPanel>
    </Grid>
</UserControl>